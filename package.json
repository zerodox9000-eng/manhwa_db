{
  "name": "mangabaka-db",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "fetch": "node scripts/fetch/fullFetch.js",
    "normalize": "node scripts/normalize/normalizeSeries.js",
    "enrich": "node scripts/enrich/updateAniList.js",
    "retry": "node scripts/enrich/retryFailed.js",
    "snapshot": "node scripts/snapshots/snapshotAniList.js",
    "build:frontend": "node scripts/build/buildFrontendExports.js",
    "build:frontend:cached": "node scripts/build/buildFrontendExports.js",
    "build:frontend:v2": "node scripts/build/buildFrontendV2Exports.js",
    "validate:frontend": "node scripts/evaluate/validateFrontendStatsExport.js",
    "validate:anilist": "node scripts/evaluate/validateAniListCoverage.js",
    "validate:frontend:v2": "node scripts/evaluate/validateFrontendV2Export.js",
    "validate:frontend:chunks": "node scripts/evaluate/validateChunkedFrontendExport.js",
    "validate:github-sizes": "node scripts/evaluate/validateGitHubFileSizes.js",
    "evaluate:recommendations": "node scripts/evaluate/recommendationContexts.js",
    "daily": "npm run update && npm run normalize && npm run enrich && npm run snapshot && npm run build:frontend",
    "update": "node scripts/updates/updateMangabaka.js",
    "incremental": "node scripts/updates/incrementalRawPatch.js",
    "daily:incremental": "npm run incremental && npm run normalize && npm run enrich && npm run snapshot && npm run build:frontend"
    
  },
